# ------------------------------------------------------------------
# .env.example  –  AI Agent Platform 環境変数テンプレート
# ------------------------------------------------------------------
# 使い方:
#   cp .env.example .env
#   .env を編集して実際の値を設定する
#   docker compose --env-file .env -f docker/docker-compose.yml up -d
# ------------------------------------------------------------------
# ※ .env をリポジトリに commit しないこと（NFR-003）

# --- FastAPI サーバー ---
API_PORT=8000

# --- LiteLLM プロキシ ---
LITELLM_PORT=4000
# LiteLLM が各 LLM バックエンドへの通信に使う API キー
# ローカル vLLM / Ollama の場合は "dummy" のままで可
LITELLM_API_KEY=dummy

# --- Amazon Bedrock (クラウド検証環境でのみ使用) ---
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=ap-northeast-1

# --- Dify Knowledge API ---
# 本番環境では実際の Dify エンドポイントと API キーを設定する
DIFY_MCP_URL=http://mock-dify-mcp:8001/mcp
DIFY_API_KEY=CHANGE_ME

# --- GitLab MCP サーバー (任意) ---
GITLAB_MCP_URL=http://gitlab-mcp:8002/mcp
GITLAB_TOKEN=CHANGE_ME

# --- Mock MCP サーバーポート (検証用) ---
MOCK_MCP_PORT=8001

# --- DB パス (コンテナ内部の絶対パス、ボリュームマウント先と合わせること) ---
DB_PATH=/app/data/data.db
